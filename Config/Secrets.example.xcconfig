// Copy to Secrets.Debug.xcconfig / Secrets.Staging.xcconfig / Secrets.Release.xcconfig (git-ignored).
// Only the project host and the PUBLISHABLE (anon) key belong in the app. Never put the
// service-role/secret key or any AI provider key here.
SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_xxx
// For `supabase start` on a simulator: SUPABASE_HOST = 127.0.0.1:54321
